<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <!--
        Minimal scaffold pom for the executor module, built only so SEC4-615's
        SettlementService compiles and tests in isolation while SEC4-614 (a
        teammate, on a different branch) builds the canonical executor/pom.xml
        for the module. This file is expected to be discarded in favor of
        theirs at merge time - the real deliverable is the classes under
        executor/src, not this file. Do not over-invest here.
    -->

    <modelVersion>4.0.0</modelVersion>

    <groupId>org.leap</groupId>
    <artifactId>executor</artifactId>
    <version>1.0-SNAPSHOT</version>
    <name>executor</name>
    <description>Sprint 7 Trade Executor (scaffold - see SEC4-614 for the canonical pom)</description>

    <properties>
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <domain.groupId>org.leap</domain.groupId>
        <domain.artifactId>sprint-05-domain</domain.artifactId>
        <domain.version>1.0-SNAPSHOT</domain.version>

        <junit.version>5.13.4</junit.version>
        <mockito.version>5.14.2</mockito.version>
        <kafka.version>3.8.0</kafka.version>
        <jackson.version>2.18.0</jackson.version>
    </properties>

    <dependencies>

        <!-- Sprint 5 domain rules and the shared org.leap.events / org.leap.pricing types -->
        <dependency>
            <groupId>${domain.groupId}</groupId>
            <artifactId>${domain.artifactId}</artifactId>
            <version>${domain.version}</version>
        </dependency>

        <!-- PostgreSQL JDBC driver: the executor talks to the database with plain JDBC, no ORM -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <version>42.7.4</version>
        </dependency>

        <!-- Logging -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
            <version>2.0.16</version>
        </dependency>

        <!-- Publishing trade-events -->
        <dependency>
            <groupId>org.apache.kafka</groupId>
            <artifactId>kafka-clients</artifactId>
            <version>${kafka.version}</version>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <version>${jackson.version}</version>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.datatype</groupId>
            <artifactId>jackson-datatype-jsr310</artifactId>
            <version>${jackson.version}</version>
        </dependency>

        <!-- Simple console logging so the guard-1 duplicate log line is visible when
             running the executor standalone for the SEC4-616 demo -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-simple</artifactId>
            <version>2.0.16</version>
            <scope>runtime</scope>
        </dependency>

        <!-- ================= Test scope ================= -->

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-core</artifactId>
            <version>${mockito.version}</version>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-junit-jupiter</artifactId>
            <version>${mockito.version}</version>
            <scope>test</scope>
        </dependency>

    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.5.4</version>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <version>3.6.2</version>
                <executions>
                    <execution>
                        <id>enforce-environment</id>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <requireJavaVersion>
                                    <version>[21,)</version>
                                </requireJavaVersion>
                                <requireMavenVersion>
                                    <version>[3.9,)</version>
                                </requireMavenVersion>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>
