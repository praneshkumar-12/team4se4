# Playwright journeys (SEC4-641). Copy to `.env` (git-ignored, never
# commit it) and fill in real values. Every base URL and credential the
# e2e specs use is read from here — never hard-coded in a spec file.
#
# The journeys run against the real stack: bring up the backends first
# (./run-local.sh start from the repo root, or `docker compose up` — see
# sprint-09-trading-ui/e2e/README.md), then `npm start` here so `ng serve`
# is proxying /auth-api and /trade-api, then `npm run e2e`.

# Where the Angular dev server is being served.
E2E_BASE_URL=http://localhost:4200

# A seeded, ACTIVE demo account's credentials (sprint-06-trade-api's demo
# seed: arun.kumar@example.com / account 1, ACC-10001). Auth-service
# requires a real @IsEmail() address and will 422 on anything else.
E2E_AUTH_EMAIL=arun.kumar@example.com
E2E_AUTH_PASSWORD=Correct-Horse-Battery-9

# Any value that is not that account's real password, for the refused
# sign-in journey. Not a real secret - it only has to be wrong.
E2E_AUTH_INVALID_PASSWORD=definitely-the-wrong-password
