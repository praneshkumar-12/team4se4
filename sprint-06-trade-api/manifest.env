# Sprint 6 engineering contract manifest.

# ---------------------------------------------------------------------------
# Sprint 5 domain engine, resolved from the local Maven repository.
# Build order on a clean machine:
#   (cd ../sprint-05-domain-engine && mvn install)
#   (cd ../sprint-06-trade-api    && mvn clean verify)
# Re-run the first line whenever the domain changes.
# ---------------------------------------------------------------------------
DOMAIN_GROUP_ID=org.leap
DOMAIN_ARTIFACT_ID=sprint-05-domain
DOMAIN_VERSION=1.0-SNAPSHOT

# ---------------------------------------------------------------------------
# Package layout. The layering checks find these by name:
#   * controller sources import nothing from the mapper package
#   * the domain artefact on the classpath carries no servlet/Spring/MyBatis type
# ---------------------------------------------------------------------------
BASE_PACKAGE=com.leap.tradeapi
CONTROLLER_PACKAGE=com.leap.tradeapi.controller
MAPPER_PACKAGE=com.leap.tradeapi.mapper

# ---------------------------------------------------------------------------
# Dynamic-SQL allowlist (SEC4-302).
#
# Every mapper statement binds every value that arrives from outside with #{},
# which becomes a JDBC bind parameter. There is currently NO entry here: no
# mapper substitutes an identifier into the SQL text. The order-history query's
# ORDER BY is a fixed constant, not a parameter and not interpolated.
#
# Format for any future entry:
#   <mapper>.<statementId> : <column-or-direction> checked against <allowlist location>
# ---------------------------------------------------------------------------
MAPPER_DYNAMIC_SQL_ALLOWLIST=