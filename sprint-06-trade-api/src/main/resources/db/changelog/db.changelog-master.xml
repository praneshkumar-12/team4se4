<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.29.xsd">

    <!--
        The Sprint 3 schema is applied by the database team's own scripts and is
        assumed to exist. This changelog carries only the additive change Sprint 6
        needs: a stable public identifier for an order, which the contract fixes
        as a UUID exposed with an "ORD-" display prefix. The numeric orders.order_id
        surrogate key stays as it is.
    -->
    <changeSet id="2026-09-10-01-orders-public-id" author="team4">
        <preConditions onFail="MARK_RAN">
            <not>
                <columnExists tableName="orders" columnName="public_id"/>
            </not>
        </preConditions>

        <addColumn tableName="orders">
            <column name="public_id" type="VARCHAR(36)"/>
        </addColumn>

        <addUniqueConstraint tableName="orders" columnNames="public_id"
                             constraintName="uq_orders_public_id"/>

        <createIndex tableName="orders" indexName="ix_orders_account_created">
            <column name="account_id"/>
            <column name="created_at"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>