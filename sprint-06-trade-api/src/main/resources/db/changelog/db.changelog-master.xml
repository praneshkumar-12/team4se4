<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.29.xsd">

    <!--
        This changelog can build the trading database from nothing (the Docker
        Postgres container starts empty) OR sit on top of a Sprint 3 schema that
        the database team's own scripts already applied.

        Every changeset below is guarded by a precondition that checks whether its
        objects already exist. On a fresh database the preconditions pass and the
        changeset runs; against an already-populated Sprint 3 database they fail
        with onFail="MARK_RAN", so the changeset is recorded as run without
        touching anything.
    -->

    <!-- Sprint 3: the seven tables with their CHECK / FK / UNIQUE constraints. -->
    <changeSet id="001-sprint3-schema" author="team4">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="accounts"/>
            </not>
        </preConditions>
        <sqlFile path="changes/001-sprint3-schema.sql"
                 relativeToChangelogFile="true"
                 splitStatements="true"
                 endDelimiter=";"/>
    </changeSet>

    <!--
        Sprint 3: the pl/pgsql trigger functions (updated_at maintenance, account
        status-transition guard, terminal-order guard, order-account-active check)
        and the query indexes. splitStatements="false" because the function bodies
        are dollar-quoted and contain their own semicolons.
    -->
    <changeSet id="002-sprint3-triggers-indexes" author="team4">
        <preConditions onFail="MARK_RAN">
            <sqlCheck expectedResult="0">
                SELECT count(*) FROM pg_proc WHERE proname = 'update_updated_at'
            </sqlCheck>
        </preConditions>
        <sqlFile path="changes/002-sprint3-triggers-indexes.sql"
                 relativeToChangelogFile="true"
                 splitStatements="false"/>
    </changeSet>

    <!--
        Sprint 6 additive change: a stable public identifier for an order, which
        the contract fixes as a UUID exposed with an "ORD-" display prefix. The
        numeric orders.order_id surrogate key stays as it is.
    -->
    <changeSet id="2026-09-10-01-orders-public-id" author="team4">
        <preConditions onFail="MARK_RAN">
            <not>
                <columnExists tableName="orders" columnName="public_id"/>
            </not>
        </preConditions>

        <addColumn tableName="orders">
            <column name="public_id" type="VARCHAR(36)"/>
        </addColumn>

        <addUniqueConstraint tableName="orders" columnNames="public_id"
                             constraintName="uq_orders_public_id"/>

        <createIndex tableName="orders" indexName="ix_orders_account_created">
            <column name="account_id"/>
            <column name="created_at"/>
        </createIndex>
    </changeSet>

    <!--
        Sprint 7 (SEC4-615) additive change: nowhere on the order records *why*
        it was rejected. Nullable, populated only when status becomes REJECTED.
    -->
    <changeSet id="2026-09-16-01-orders-rejection-reason" author="team4">
        <preConditions onFail="MARK_RAN">
            <not>
                <columnExists tableName="orders" columnName="rejection_reason"/>
            </not>
        </preConditions>
        <addColumn tableName="orders">
            <column name="rejection_reason" type="VARCHAR(255)"/>
        </addColumn>
    </changeSet>

    <!--
        Demo walkthrough data (Sprint 3 seed): three clients/accounts across the
        ACTIVE / SUSPENDED / CLOSED states, three instruments, and one order of
        every lifecycle state with a matching trade and holding.

        context="demo" - loaded only when LIQUIBASE_CONTEXTS includes "demo"
        (docker-compose sets this from .env). The precondition also skips it if
        the accounts table is already populated.
    -->
    <changeSet id="003-demo-seed" author="team4" context="demo">
        <preConditions onFail="MARK_RAN">
            <sqlCheck expectedResult="0">SELECT count(*) FROM accounts</sqlCheck>
        </preConditions>
        <sqlFile path="changes/003-demo-seed.sql"
                 relativeToChangelogFile="true"
                 splitStatements="true"
                 endDelimiter=";"/>
    </changeSet>

</databaseChangeLog>
