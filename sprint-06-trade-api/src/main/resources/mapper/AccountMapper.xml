<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.leap.tradeapi.mapper.AccountMapper">

    <!-- accounts joined to clients, mapped straight onto the Sprint 5 domain Account. -->
    <resultMap id="accountDomain" type="org.leap.domain.Account">
        <constructor>
            <idArg  column="account_id"        javaType="java.lang.Long"/>
            <arg    column="account_reference" javaType="java.lang.String"/>
            <arg    column="first_name"        javaType="java.lang.String"/>
            <arg    column="last_name"         javaType="java.lang.String"/>
            <arg    column="currency"          javaType="java.lang.String"/>
            <arg    column="cash_balance"      javaType="java.math.BigDecimal"/>
            <arg    column="account_status"    javaType="org.leap.domain.enums.AccountStatus"/>
            <arg    column="version"           javaType="java.lang.Long"/>
        </constructor>
    </resultMap>

    <resultMap id="accountDetailsRow" type="com.leap.tradeapi.mapper.row.AccountDetailsRow">
        <constructor>
            <idArg  column="id"            javaType="java.lang.Long"/>
            <arg    column="account_ref"   javaType="java.lang.String"/>
            <arg    column="holder_name"   javaType="java.lang.String"/>
            <arg    column="cash_balance"  javaType="java.math.BigDecimal"/>
            <arg    column="status"        javaType="org.leap.domain.enums.AccountStatus"/>
            <arg    column="version"       javaType="java.lang.Long"/>
            <arg    column="last_updated"  javaType="java.time.Instant"/>
        </constructor>
    </resultMap>

    <resultMap id="balanceRow" type="com.leap.tradeapi.mapper.row.BalanceRow">
        <constructor>
            <idArg  column="account_id"    javaType="java.lang.Long"/>
            <arg    column="cash_balance"  javaType="java.math.BigDecimal"/>
            <arg    column="currency"      javaType="java.lang.String"/>
        </constructor>
    </resultMap>

    <select id="findDomainById" resultMap="accountDomain">
        SELECT a.account_id,
               a.account_reference,
               c.first_name,
               c.last_name,
               a.currency,
               a.cash_balance,
               a.account_status,
               a.version
        FROM accounts a
        JOIN clients c ON c.client_id = a.client_id
        WHERE a.account_id = #{accountId}
    </select>

    <select id="findDetails" resultMap="accountDetailsRow">
        SELECT a.account_id                              AS id,
               a.account_reference                       AS account_ref,
               CONCAT(c.first_name, ' ', c.last_name)    AS holder_name,
               a.cash_balance,
               a.account_status                          AS status,
               a.version,
               a.updated_at                              AS last_updated
        FROM accounts a
        JOIN clients c ON c.client_id = a.client_id
        WHERE a.account_id = #{accountId}
    </select>

    <select id="findBalance" resultMap="balanceRow">
        SELECT account_id, cash_balance, currency
        FROM accounts
        WHERE account_id = #{accountId}
    </select>

    <select id="existsById" resultType="boolean">
        SELECT EXISTS (
            SELECT 1 FROM accounts WHERE account_id = #{accountId}
        )
    </select>

    <update id="updateBalanceWithVersion">
        UPDATE accounts
        SET cash_balance = #{cashBalance},
            version      = version + 1,
            updated_at   = CURRENT_TIMESTAMP
        WHERE account_id = #{accountId}
          AND version    = #{expectedVersion}
    </update>

</mapper>
