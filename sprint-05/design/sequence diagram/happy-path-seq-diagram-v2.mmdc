sequenceDiagram
    autonumber

    actor Client
    participant S as OrderPlacementService
    participant ID as IdempotencyChecker
    participant O as Order
    participant V as OrderValidator
    participant AP as AccountProvider
    participant IP as InstrumentProvider
    participant PP as PositionProvider
    participant A as Account
    participant I as Instrument
    participant P as Position
    participant E as OrderExecutor

    Client->>S: placeOrder(request)
    activate S

    S->>ID: reserve(idempotencyKey)
    activate ID
    ID-->>S: true
    deactivate ID

    S->>O: create(request)
    activate O
    O-->>S: Order NEW
    deactivate O

    S->>V: validate(order)
    activate V

    V->>AP: findById(accountId)
    activate AP
    AP-->>V: Account
    deactivate AP

    V->>A: isActive()
    activate A
    A-->>V: true
    deactivate A

    V->>IP: findBySymbol(symbol)
    activate IP
    IP-->>V: Instrument
    deactivate IP

    V->>I: isTradable()
    activate I
    I-->>V: true
    deactivate I

    V->>V: validateQuantity(quantity)
    V->>V: validatePrice(price)

    V->>A: canAfford(quantity × price)
    activate A
    A-->>V: true
    deactivate A

    V->>PP: find(account, instrument)
    activate PP
    PP-->>V: Position
    deactivate PP

    V->>P: hasEnough(quantity)
    activate P
    P-->>V: true
    deactivate P

    V-->>S: validation successful
    deactivate V

    S->>E: execute(order)
    activate E

    E->>A: debit(amount)
    activate A
    A-->>E: balance updated
    deactivate A

    E->>P: buy/sell(quantity)
    activate P
    P-->>E: position updated
    deactivate P

    E->>O: fill(executedPrice)
    activate O
    O-->>E: Order FILLED
    deactivate O

    E-->>S: execution successful
    deactivate E

    S-->>Client: Order FILLED
    deactivate S