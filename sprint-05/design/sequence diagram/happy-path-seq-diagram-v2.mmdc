sequenceDiagram
    actor Client
    participant S as OrderPlacementService
    participant AP as AccountProvider
    participant IP as InstrumentProvider
    participant PP as PositionProvider
    participant V as OrderValidator
    participant ID as IdempotencyChecker
    participant O as Order
    participant E as OrderExecutor
    participant A as Account
    participant P as Position

    Client->>S: placeOrder(request)
    activate S

    S->>AP: findById(accountId)
    activate AP
    AP-->>S: Account
    deactivate AP

    S->>IP: findBySymbol(symbol)
    activate IP
    IP-->>S: Instrument
    deactivate IP

    S->>PP: find(account, instrument)
    activate PP
    PP-->>S: Position
    deactivate PP

    S->>V: validateAccount(account)
    activate V
    V-->>S: valid
    deactivate V

    S->>V: validateInstrument(instrument)
    activate V
    V-->>S: valid
    deactivate V

    S->>V: validateQuantity(quantity)
    activate V
    V-->>S: valid
    deactivate V

    S->>V: validatePrice(price)
    activate V
    V-->>S: valid
    deactivate V

    S->>V: validateFunds(account, order)
    activate V
    V-->>S: valid
    deactivate V

    S->>V: validateHoldings(position, order)
    activate V
    V-->>S: valid
    deactivate V

    S->>ID: reserve(idempotencyKey)
    activate ID
    ID-->>S: reserved
    deactivate ID

    S->>O: create(account, instrument, request)
    activate O
    O-->>S: Order NEW
    deactivate O

    S->>E: execute(order)
    activate E

    E->>A: debit(totalValue)
    activate A
    A-->>E: cash updated
    deactivate A

    E->>P: buy(quantity, price)
    activate P
    P-->>E: position updated
    deactivate P

    E->>O: fill(executedPrice)
    activate O
    O-->>E: Order FILLED
    deactivate O

    E-->>S: execution successful
    deactivate E

    S-->>Client: Order FILLED
    deactivate S