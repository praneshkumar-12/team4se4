sequenceDiagram
    actor Client
    participant S as OrderPlacementService
    participant AP as AccountProvider
    participant IP as InstrumentProvider
    participant PP as PositionProvider
    participant V as OrderValidator
    participant ID as IdempotencyChecker
    participant O as Order
    participant E as OrderExecutor
    participant A as Account
    participant P as Position

    Client->>S: placeOrder(request)
    activate S

    %% Rule 1
    S->>AP: findById(accountId)
    activate AP
    AP-->>S: Account or null
    deactivate AP

    alt Account not found
        S->>O: createRejected(request)
        activate O
        O-->>S: REJECTED
        deactivate O
        S-->>Client: ACC-404 Account not found
    else Account found

        %% Rule 2
        S->>V: validateAccount(account)
        activate V
        V-->>S: valid or AccountNotActiveException
        deactivate V

        alt Account not ACTIVE
            S->>O: createRejected(request)
            activate O
            O-->>S: REJECTED
            deactivate O
            S-->>Client: ACC-403 Account not active
        else Account ACTIVE

            %% Rule 3
            S->>IP: findBySymbol(symbol)
            activate IP
            IP-->>S: Instrument or null
            deactivate IP

            alt Instrument not found / not tradable
                S->>O: createRejected(request)
                activate O
                O-->>S: REJECTED
                deactivate O
                S-->>Client: INS-404 Instrument unavailable
            else Instrument valid

                %% Rule 4
                S->>V: validateQuantity(quantity)
                activate V
                V-->>S: valid or ValidationException
                deactivate V

                alt Quantity <= 0
                    S->>O: createRejected(request)
                    activate O
                    O-->>S: REJECTED
                    deactivate O
                    S-->>Client: VAL-422 Invalid quantity
                else Quantity valid

                    %% Rule 5
                    S->>V: validatePrice(price)
                    activate V
                    V-->>S: valid or ValidationException
                    deactivate V

                    alt Price <= 0
                        S->>O: createRejected(request)
                        activate O
                        O-->>S: REJECTED
                        deactivate O
                        S-->>Client: VAL-422 Invalid price
                    else Price valid

                        %% Position lookup
                        S->>PP: find(account, instrument)
                        activate PP
                        PP-->>S: Position
                        deactivate PP

                        %% Create temporary order for validation
                        S->>O: create(request, account, instrument)
                        activate O
                        O-->>S: Order NEW
                        deactivate O

                        %% Rule 6
                        alt BUY order
                            S->>V: validateFunds(account, order)
                            activate V
                            V-->>S: valid or InsufficientFundsException
                            deactivate V

                            alt Insufficient funds
                                S->>O: reject()
                                activate O
                                O-->>S: REJECTED
                                deactivate O
                                S-->>Client: ORD-400 Insufficient funds
                            else Funds sufficient

                                %% Rule 7
                                S->>ID: reserve(idempotencyKey)
                                activate ID
                                ID-->>S: reserved or duplicate
                                deactivate ID

                                alt Duplicate idempotency key
                                    S->>O: reject()
                                    activate O
                                    O-->>S: REJECTED
                                    deactivate O
                                    S-->>Client: ORD-409 Duplicate order
                                else Key available

                                    S->>E: execute(order)
                                    activate E

                                    E->>A: debit(quantity * price)
                                    activate A
                                    A-->>E: cash updated
                                    deactivate A

                                    E->>P: buy(quantity, price)
                                    activate P
                                    P-->>E: position updated
                                    deactivate P

                                    E->>O: fill(executedPrice)
                                    activate O
                                    O-->>E: FILLED
                                    deactivate O

                                    E-->>S: execution successful
                                    deactivate E

                                    S-->>Client: Order FILLED
                                end
                            end

                        else SELL order

                            %% Rule 7
                            S->>V: validateHoldings(position, order)
                            activate V
                            V-->>S: valid or InsufficientHoldingsException
                            deactivate V

                            alt Insufficient holdings
                                S->>O: reject()
                                activate O
                                O-->>S: REJECTED
                                deactivate O
                                S-->>Client: ORD-409 Insufficient holdings
                            else Holdings sufficient

                                %% Rule 8
                                S->>ID: reserve(idempotencyKey)
                                activate ID
                                ID-->>S: reserved or duplicate
                                deactivate ID

                                alt Duplicate idempotency key
                                    S->>O: reject()
                                    activate O
                                    O-->>S: REJECTED
                                    deactivate O
                                    S-->>Client: ORD-409 Duplicate order
                                else Key available

                                    S->>E: execute(order)
                                    activate E

                                    E->>P: sell(quantity)
                                    activate P
                                    P-->>E: position updated
                                    deactivate P

                                    E->>A: credit(quantity * price)
                                    activate A
                                    A-->>E: cash updated
                                    deactivate A

                                    E->>O: fill(executedPrice)
                                    activate O
                                    O-->>E: FILLED
                                    deactivate O

                                    E-->>S: execution successful
                                    deactivate E

                                    S-->>Client: Order FILLED
                                end
                            end
                        end
                    end
                end
            end
        end
    end

    deactivate S