sequenceDiagram
    autonumber

    actor Client
    participant S as OrderPlacementService
    participant ID as IdempotencyChecker
    participant O as Order
    participant V as OrderValidator
    participant AP as AccountProvider
    participant IP as InstrumentProvider
    participant PP as PositionProvider
    participant A as Account
    participant I as Instrument
    participant P as Position

    Client->>S: placeOrder(request)
    activate S

    S->>ID: reserve(idempotencyKey)
    activate ID
    ID-->>S: reserved / duplicate
    deactivate ID

    alt Duplicate order
        S-->>Client: DuplicateOrderException(ORD-409)

    else New idempotency key

        S->>O: create(request)
        activate O
        O-->>S: Order NEW
        deactivate O

        S->>V: validate(order)
        activate V

        V->>AP: findById(accountId)
        activate AP
        AP-->>V: Account / null
        deactivate AP

        alt Account not found
            V-->>S: AccountNotFoundException(ACC-404)

            S->>O: reject()
            activate O
            O-->>S: Order REJECTED
            deactivate O

            S-->>Client: Order rejected

        else Account found

            V->>A: isActive()
            activate A
            A-->>V: true / false
            deactivate A

            alt Account inactive
                V-->>S: AccountNotActiveException(ACC-403)

                S->>O: reject()
                activate O
                O-->>S: Order REJECTED
                deactivate O

                S-->>Client: Order rejected

            else Account active

                V->>IP: findBySymbol(symbol)
                activate IP
                IP-->>V: Instrument / null
                deactivate IP

                alt Instrument not found
                    V-->>S: InstrumentNotFoundException(INS-404)

                    S->>O: reject()
                    activate O
                    O-->>S: Order REJECTED
                    deactivate O

                    S-->>Client: Order rejected

                else Instrument found

                    V->>I: isTradable()
                    activate I
                    I-->>V: true / false
                    deactivate I

                    alt Instrument not tradable
                        V-->>S: InstrumentNotFoundException(INS-404)

                        S->>O: reject()
                        activate O
                        O-->>S: Order REJECTED
                        deactivate O

                        S-->>Client: Order rejected

                    else Instrument tradable

                        V->>V: validateQuantity(quantity)

                        alt Invalid quantity
                            V-->>S: DomainValidationException(VAL-422)

                            S->>O: reject()
                            activate O
                            O-->>S: Order REJECTED
                            deactivate O

                            S-->>Client: Order rejected

                        else Valid quantity

                            V->>V: validatePrice(price)

                            alt Invalid price
                                V-->>S: DomainValidationException(VAL-422)

                                S->>O: reject()
                                activate O
                                O-->>S: Order REJECTED
                                deactivate O

                                S-->>Client: Order rejected

                            else Valid price

                                V->>A: canAfford(quantity × price)
                                activate A
                                A-->>V: true / false
                                deactivate A

                                alt Insufficient funds
                                    V-->>S: InsufficientFundsException(ORD-400)

                                    S->>O: reject()
                                    activate O
                                    O-->>S: Order REJECTED
                                    deactivate O

                                    S-->>Client: Order rejected

                                else Enough funds

                                    V->>PP: find(account, instrument)
                                    activate PP
                                    PP-->>V: Position
                                    deactivate PP

                                    V->>P: hasEnough(quantity)
                                    activate P
                                    P-->>V: true / false
                                    deactivate P

                                    alt Insufficient holdings
                                        V-->>S: InsufficientHoldingsException(ORD-409)

                                        S->>O: reject()
                                        activate O
                                        O-->>S: Order REJECTED
                                        deactivate O

                                        S-->>Client: Order rejected

                                    else Enough holdings
                                        V-->>S: Validation successful
                                    end

                                end
                            end
                        end
                    end
                end
            end
        end

        deactivate V
    end

    deactivate S