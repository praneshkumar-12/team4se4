# Settings for run-local.sh. Copy to run-local.env (git-ignored) and fill in
# your own values. run-local.env must never be committed.
#
# Format: KEY=VALUE, one per line. Quotes are optional and stripped. Values
# are taken literally (a password may contain ! $ or spaces). No inline
# comments: everything after the first = is the value.

# --- Remote Kafka VM ---------------------------------------------------------
VM_HOST=CHANGE_ME_VM_HOST
VM_USER=CHANGE_ME_VM_USER
VM_PASSWORD=CHANGE_ME_VM_PASSWORD

# --- Local PostgreSQL (the password you set when installing Postgres) -------
DB_PASSWORD=CHANGE_ME_DB_PASSWORD

# --- Auth ----------------------------------------------------------------------
# Signs and verifies access tokens; auth-service and trade-api both start with
# this value. 32+ characters, e.g. the output of: openssl rand -hex 32
JWT_SECRET=CHANGE_ME_JWT_SECRET

# --- Fauxnance market data -----------------------------------------------------
FAUXNANCE_API_KEY=CHANGE_ME_FAUXNANCE_API_KEY

# --- Optional overrides (defaults live in run-local.sh) -----------------------
# JAVA_HOME=/c/Program Files/Java/jdk-21
# DB_USER=postgres
# DB_PORT=5432
# KAFKA_VM_PORT=8081
# RUN_AUTH_SERVICE=true
