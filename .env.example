# Enterprise Trading Platform, local environment.
#
# Copy this file to .env and fill in the values marked "replace". .env is
# git-ignored; .env.example is the template that is committed. Add a variable
# here, without its real value, whenever you add one to a service.

# --- PostgreSQL --------------------------------------------------------------
POSTGRES_DB=trade_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_dev_password

# --- Analytics ETL (Sprint 7) ----------------------------------------------
# Host/port to reach the same Postgres above from outside docker-compose (the
# ETL runs as a local process, not a container). Defaults already match the
# port docker-compose.yml exposes, so these two are only needed to override.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# Where the ETL's DuckDB warehouse file is written, relative to etl/.
DUCKDB_PATH=data/warehouse.duckdb

# --- Kafka (Sprint 7) ------------------------------------------------------
KAFKA_BOOTSTRAP_SERVERS=kafka:29092

# --- Authentication -------------------------------------------------------
# Shared HS256 signing secret. The auth service (Sprint 8) signs with it and the
# Trade REST API verifies with it. 32 characters or more: a short HS256 secret
# is brute-forceable offline. The Trade REST API reads it as JWT_SECRET and it
# never appears in any committed file or in browser code.
JWT_SECRET=dev-only-change-me-this-secret-is-not-for-production-use
JWT_ISSUER=auth-service

# Liquibase contexts for the Trade REST API. "demo" loads the walkthrough seed;
# set empty to run the schema only.
LIQUIBASE_CONTEXTS=demo

# --- Fauxnance API (Sprint 4, Sprint 7, Sprint 10) -----------------------
FAUXNANCE_BASE_URL=https://y4t9nq2bqf.execute-api.eu-west-2.amazonaws.com/v1
FAUXNANCE_API_KEY=replace-with-your-fauxnance-key