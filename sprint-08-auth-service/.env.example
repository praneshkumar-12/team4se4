# Local, standalone dev only (npm run start:dev outside Docker). Copy to
# .env in this folder and fill in the values. Inside docker-compose these
# are supplied by the orchestration environment from the repo root .env
# instead - see ../docker-compose.yml and ../.env.example.

PORT=3000

DB_HOST=localhost
DB_PORT=8091
DB_NAME=trade_db
DB_USER=postgres
DB_PASSWORD=postgres_dev_password

# Shared with the Trade REST API. 32 characters or more.
JWT_SECRET=dev-only-change-me-this-secret-is-not-for-production-use
JWT_ISSUER=auth-service
